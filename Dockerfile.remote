# The Node runtime image. Node 24 is the only supported major (engines.node >=24.2); CI builds with
#   docker build -f Dockerfile.remote --build-arg NODE_IMAGE=node:24-bookworm-slim .
# Keep the Debian release (bookworm) the same as the python:3.12-slim-bookworm runtime stage,
# because only the node binary is copied across and it links against the runtime's glibc and libstdc++.
ARG NODE_IMAGE=node:24-bookworm-slim
FROM oven/bun:1.4.2 AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
RUN bun run build:remote
# The example client is compiled to plain Node JavaScript. Its only import is
# @modelcontextprotocol/sdk, left external and resolved from the runtime node_modules.
COPY examples/upload-and-convert.ts ./examples/upload-and-convert.ts
RUN bun build examples/upload-and-convert.ts --target=node --packages=external --outfile build-examples/upload-and-convert.js

# Install afresh so TypeScript and other development-only packages stay out of runtime.
FROM oven/bun:1.4.2 AS production-deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts --production

FROM ${NODE_IMAGE} AS node
FROM python:3.12-slim-bookworm AS runtime
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="Markdownify remote MCP" \
    org.opencontainers.image.description="Authenticated temporary uploads and isolated agent Markdown conversion jobs" \
    org.opencontainers.image.source="https://github.com/bxm156/markdownify-mcp" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.licenses="MIT"
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir 'markitdown[pdf,docx,xlsx,pptx]==0.1.5' \
    && groupadd --gid 10001 markdownify \
    && useradd --uid 10001 --gid markdownify --create-home markdownify
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY --from=production-deps /app/node_modules ./node_modules
COPY package.json LICENSE SKILL.md ./
COPY --chmod=755 docker-entrypoint.sh ./docker-entrypoint.sh
COPY docs/REMOTE.md docs/MULTITENANT.md docs/CONTAINERS.md docs/QUICKSTART.md docs/ERRORS.md docs/JWT.md docs/HEALTH.md ./docs/
COPY --from=build /app/build-examples/upload-and-convert.js ./examples/upload-and-convert.js
RUN mkdir /data && chown 10001:10001 /data
ENV NODE_ENV=production MD_HOST=0.0.0.0 MD_PORT=8000 MD_DATA_DIR=/data
USER 10001:10001
EXPOSE 8000
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8000/livez').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["remote"]
