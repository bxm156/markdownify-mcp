FROM oven/bun:1.4.2 AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
RUN bun run build:remote

# Install afresh so TypeScript and other development-only packages stay out of runtime.
FROM oven/bun:1.4.2 AS production-deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts --production

FROM node:22-bookworm-slim AS node
FROM python:3.12-slim-bookworm AS runtime
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="Markdownify remote MCP" \
    org.opencontainers.image.description="Authenticated temporary uploads and isolated agent Markdown conversion jobs" \
    org.opencontainers.image.source="https://github.com/bxm156/markdownify-mcp" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.licenses="MIT"
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir 'markitdown[pdf,docx,xlsx,pptx]==0.1.5' \
    && groupadd --gid 10001 markdownify \
    && useradd --uid 10001 --gid markdownify --create-home markdownify
WORKDIR /app
COPY --from=build /app/dist ./dist
COPY --from=production-deps /app/node_modules ./node_modules
COPY package.json LICENSE SKILL.md ./
COPY docs/REMOTE.md docs/MULTITENANT.md docs/CONTAINERS.md docs/QUICKSTART.md ./docs/
COPY examples/upload-and-convert.ts ./examples/upload-and-convert.ts
RUN mkdir /data && chown 10001:10001 /data
ENV NODE_ENV=production MD_HOST=0.0.0.0 MD_PORT=8000 MD_DATA_DIR=/data
USER 10001:10001
EXPOSE 8000
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8000/healthz',{headers:{Host:new URL(process.env.MD_PUBLIC_BASE_URL||'http://localhost:8000').host}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/remote/index.js"]
