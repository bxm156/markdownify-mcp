# Legacy single-agent mode. For isolated agents, use .env.multitenant.example
# and compose.multitenant.yaml; MD_AUTH_FILE cannot coexist with MD_API_KEY.
# Copy to .env.remote; supply a random secret of at least 32 characters.
MD_API_KEY=
# Must match the public HTTPS origin after reverse-proxy deployment.
MD_PUBLIC_BASE_URL=http://localhost:8000
MD_HOST=127.0.0.1
MD_PORT=8000
MD_DATA_DIR=./data
MD_MAX_UPLOAD_BYTES=26214400
MD_MAX_STORAGE_BYTES=268435456
MD_MAX_JOBS=100
MD_RETENTION_MS=86400000
MD_UPLOAD_TTL_MS=900000
MD_CONVERSION_TIMEOUT_MS=120000
MD_MAX_OUTPUT_BYTES=26214400
MD_CONCURRENCY=2
