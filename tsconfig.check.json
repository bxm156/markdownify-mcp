{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "examples/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
