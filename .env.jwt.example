# Recommended LiteLLM outbound-signer mode. Do not set MD_API_KEY or MD_AUTH_FILE.
MD_PUBLIC_BASE_URL=http://localhost:8000
MD_JWT_ISSUER=https://litellm.example.com
MD_JWT_AUDIENCE=markdownify
MD_JWT_JWKS_URL=https://litellm.example.com/.well-known/jwks.json
# compose.jwt.yaml supplies MD_JWT_PRINCIPALS_FILE.
MD_JWT_MAX_TTL_SECONDS=300
MD_JWT_TOOL_PREFIX=markdownify-
# JWT-mode upload credentials expire after min(this value, 5 minutes).
MD_UPLOAD_TTL_MS=300000
MD_RETENTION_MS=86400000
MD_MAX_UPLOAD_BYTES=26214400
MD_MAX_OUTPUT_BYTES=26214400
MD_MAX_STORAGE_BYTES=268435456
MD_MAX_JOBS=100
MD_MAX_TENANT_JOBS=25
MD_MAX_AGENT_JOBS=10

