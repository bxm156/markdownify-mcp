# Copy to .env.multitenant. Do not set MD_API_KEY in this file.
# compose.multitenant.yaml sets MD_AUTH_FILE to the mounted credential registry.
MD_PUBLIC_BASE_URL=http://localhost:8000
# Optional if a proxy rewrites Host; defaults include the public origin and probes.
# MD_ALLOWED_HOSTS=markdownify.example.com,localhost:8000,127.0.0.1:8000
MD_MAX_UPLOAD_BYTES=26214400
MD_MAX_STORAGE_BYTES=268435456
MD_MAX_JOBS=100
MD_RETENTION_MS=86400000
MD_UPLOAD_TTL_MS=900000
MD_CONVERSION_TIMEOUT_MS=120000
MD_MAX_OUTPUT_BYTES=26214400
MD_CONCURRENCY=2
MD_MAX_TENANT_JOBS=25
MD_MAX_TENANT_STORAGE_BYTES=134217728
MD_MAX_TENANT_CONCURRENCY=1
MD_MAX_AGENT_JOBS=10
MD_MAX_AGENT_STORAGE_BYTES=134217728
MD_MAX_AGENT_CONCURRENCY=1
